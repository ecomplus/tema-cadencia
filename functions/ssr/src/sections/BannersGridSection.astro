---
import type { CmsFields, InferCmsOutput } from '@@sf/content';
import { bannerListCmsField } from '@@sf/composables/use-banner';
import Picture from '@@sf/components/Picture.astro';

/*
 * Grade de banners — variante Cadência (artigos esportivos).
 *
 * NÃO usa o `Banner.vue` do starter. Com `title`/`subtitle` preenchidos ele
 * vira um grid de duas colunas com `p-12 xl:ps-32`, dimensionado para largura
 * total. Numa coluna de 1/3 o texto quebra UMA PALAVRA POR LINHA e a imagem
 * some — foi exatamente o que apareceu no primeiro print desta loja, e é o
 * mesmo defeito que a Bitola já tinha documentado.
 *
 * Idioma do nicho: foto cheia com a tarja de modalidade por cima, no canto
 * inferior. O volt entra só no filete da borda inferior e no estado de hover —
 * é a regra do tema (ver `assets/style.css`): volt marca, não preenche.
 */
export const cmsFields = ({
  banners: { required: true, ...bannerListCmsField },
}) as const satisfies CmsFields;

export type Props = InferCmsOutput<typeof cmsFields>;
const { banners = [] } = Astro.props;

/*
 * O número de colunas segue a quantidade de banners cadastrada, em vez de ser
 * fixo em 3. Esta loja tem QUATRO modalidades (corrida, futebol, ciclismo,
 * musculação) e com `sm:grid-cols-3` a quarta caía sozinha numa linha, ocupando
 * um terço da largura ao lado de dois vazios.
 */
const colunas = banners.length % 4 === 0
  ? 'sm:grid-cols-2 lg:grid-cols-4'
  : 'sm:grid-cols-3';
---

<section class="ui-section">
  <ul class:list={['grid grid-cols-1 gap-4', colunas]}>
    {banners.map((banner) => (
      <li>
        <a
          href={banner.href || '#'}
          class="group relative block overflow-hidden rounded-lg
          border-b-4 border-transparent transition hover:border-secondary"
        >
          <Picture
            src={banner.img}
            alt={banner.alt || ''}
            widths={[400, 640, 828]}
            sizes="(min-width: 640px) 33vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover transition-transform
            duration-500 md:group-hover:scale-105"
          />
          {(banner.title || banner.subtitle) && (
            <div
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t
              from-base-950/85 via-base-950/55 to-transparent px-4 pb-4 pt-10"
            >
              {banner.title && (
                <h3 class="ui-text-brand text-2xl leading-none text-white">
                  {banner.title}
                </h3>
              )}
              {banner.subtitle && (
                <p class="mt-1 text-xs font-medium text-base-200">
                  {banner.subtitle}
                </p>
              )}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
